// Task routes
app.get('/api/tasks/:farmId', async (req, res) => {
    try {
        const tasks = await FarmTask.find({ farmId: req.params.farmId })
        res.json(tasks)
    } catch (error) {
        res.status(500).json({ error: error.message })
    }
})

app.post('/api/tasks', async (req, res) => {
    try {
        const task = new FarmTask(req.body)
        await task.save()
        res.json(task)
    } catch (error) {
        res.status(500).json({ error: error.message })
